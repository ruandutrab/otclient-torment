AutoLootItem < UIItem
  size: 34 34
  virtual: true
  selectable: true
  image-source: /images/ui/item

MiniWindow
  id: autoLootWindow
  height: 292
  @onOpen: modules.game_autoloot.onMiniWindowOpen()
  @onClose: modules.game_autoloot.onMiniWindowClose()
  &save: true

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/icons/icon-lootanalyser-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Auto Loot')
    color: #9d9d9dff

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-right: 2
    margin-bottom: 4
    margin-top: -2
    padding-left: 2
    padding-right: 2
    layout:
      type: verticalBox

    CheckBox
      id: enabled
      !text: tr('Enabled')
      height: 16
      margin-top: 2

    CheckBox
      id: lootAll
      !text: tr('Loot everything else')
      height: 16
      margin-top: 2
      !tooltip: tr('Listed items are ignored. Leave this off to loot only the items below.')

    CheckBox
      id: walkToCorpse
      !text: tr('Walk to corpse')
      height: 16
      margin-top: 2
      !tooltip: tr('Walk up to a corpse that is out of reach. Manual walking and combat pause this.')

    Label
      id: itemsLabel
      !text: tr('Items to loot')
      height: 14
      margin-top: 6
      color: #c0c0c0
      !tooltip: tr('Drag items from your backpack. Right-click a slot to clear it.')

    Panel
      id: items
      height: 70
      margin-top: 2
      layout:
        type: grid
        cell-size: 34 34
        flow: true

    Label
      id: containersLabel
      !text: tr('Backpacks')
      height: 14
      margin-top: 4
      color: #c0c0c0
      !tooltip: tr('Backpacks that receive the loot. The next one opens when the current is full.')

    Panel
      id: containers
      height: 36
      margin-top: 2
      layout:
        type: horizontalBox
        spacing: 2

    Panel
      id: distanceRow
      height: 18
      margin-top: 4
      layout:
        type: horizontalBox
        spacing: 4

      Label
        id: distanceLabel
        !text: tr('Distance')
        width: 58
        height: 18
        color: #c0c0c0

      TextEdit
        id: maxDistance
        width: 32
        height: 18

      Label
        id: delayLabel
        !text: tr('Delay')
        width: 40
        height: 18
        margin-left: 6
        color: #c0c0c0

      TextEdit
        id: lootDelay
        width: 40
        height: 18

    Label
      id: status
      !text: tr('Idle')
      height: 16
      margin-top: 4
      color: #c0c0c0
